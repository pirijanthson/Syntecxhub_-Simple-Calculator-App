<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/soluction"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:text="0"
        android:textAlignment="textEnd"
        android:textColor="@color/black"
        android:layout_above="@id/result"
        android:textSize="32dp" />

    <TextView
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="0"
        android:textAlignment="textEnd"
        android:textColor="@color/black"
        android:layout_above="@id/button_layout"
        android:textSize="64dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/button_layout"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:background="#610B0B0B"
        android:paddingVertical="64dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:backgroundTint="#FF0950"
                android:text="C"
                android:id="@+id/button_C"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:backgroundTint="#2FB9CA"
                android:text="("
                android:id="@+id/button_open_bracket"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:backgroundTint="#2FB9CA"
                android:text=")"
                android:id="@+id/button_close_bracket"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:backgroundTint="#F84006"
                android:text="/"
                android:id="@+id/button_divide"
                android:layout_margin="12dp"/>


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:text="7"
                android:id="@+id/button_7"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:text="8"
                android:id="@+id/button_8"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:text="9"
                android:id="@+id/button_9"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:backgroundTint="#F84006"
                android:text="*"
                android:id="@+id/button_multible"
                android:layout_margin="12dp"/>


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:text="4"
                android:id="@+id/button_4"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:text="5"
                android:id="@+id/button_5"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:text="6"
                android:id="@+id/button_6"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:backgroundTint="#F84006"
                android:text="+"
                android:id="@+id/button_Addition"
                android:layout_margin="12dp"/>


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:text="1"
                android:id="@+id/button_1"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:text="2"
                android:id="@+id/button_2"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:text="3"
                android:id="@+id/button_3"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:backgroundTint="#F84006"
                android:text="-"
                android:id="@+id/button_Subtraction"
                android:layout_margin="12dp"/>


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="20dp"
                android:textColor="@color/white"
                android:backgroundTint="#FF0950"
                android:text="AC"
                android:id="@+id/button_AC"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:text="0"
                android:id="@+id/button_0"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:text="."
                android:id="@+id/button_point"
                android:layout_margin="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:layout_height="72dp"
                android:layout_width="72dp"
                app:cornerRadius="32dp"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
                android:textSize="32dp"
                android:textColor="@color/white"
                android:backgroundTint="#F84006"
                android:text="="
                android:id="@+id/button_equal"
                android:layout_margin="12dp"/>


        </LinearLayout>

    </LinearLayout>

</RelativeLayout>